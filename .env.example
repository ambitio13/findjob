# Root environment for Docker Compose. Copy to .env and adjust.
# No secrets are committed here.

# PostgreSQL
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=job_search_agent

# Backend
APP_ENV=local
DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/job_search_agent
REDIS_URL=redis://redis:6379/0
MODEL_PROVIDER=auto
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=
MODEL_DEFAULT_MODEL=deepseek-chat

# Daily model call budget (08-15-model-gateway-budget-circuit).
# Every real LLM call (chat + structured) increments a Redis daily counter.
# When MODEL_DAILY_CALL_LIMIT is exceeded, the call is rejected with 429 and
# /api/v1/health reports model_budget_tripped=true until UTC midnight.
# Set MODEL_DAILY_BUDGET_ENABLED=false to disable (not recommended in prod).
# On Redis outage, MODEL_BUDGET_FAIL_OPEN=true lets calls through (the
# provider-side API key quota is the second line of defense).
MODEL_DAILY_CALL_LIMIT=500
MODEL_DAILY_BUDGET_ENABLED=true
MODEL_BUDGET_FAIL_OPEN=true

# Userscript bridge (BOSS platform local-dev convenience).
# Controls whether the backend adapter uses the userscript-bridge data plane
# (Tampermonkey userscript running in the BOSS page). Default 0 (disabled) so a
# fresh deploy does not expose the bridge. Set to 1 for local development only.
# NOTE: this is separate from the router-level prod gate — even when enabled,
# the bridge routes are never mounted in prod (APP_ENV=prod).
BOSS_USERSCRIPT_BRIDGE_ENABLED=0

# Content-at-rest encryption (08-15-content-key-decouple).
# Dedicated Fernet key for encrypting user-supplied long text (e.g. jd_raw).
# Decouples content encryption from AUTH_SECRET_KEY so either key can be
# rotated independently. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# In prod this MUST be set (missing key = startup error). In local/test
# leaving it empty falls back to the legacy AUTH_SECRET_KEY-derived key.
# WARNING: losing this key makes all enc2$ content unrecoverable. Back it up.
CONTENT_ENCRYPTION_KEY=

# Reverse-proxy real-IP trust chain (08-15-proxy-real-ip-trust-chain).
# Comma-separated list of IPs allowed to set trusted X-Forwarded-For.
# In docker compose, set this to the frontend/nginx container's fixed IP
# (172.28.0.10). NEVER use "*": a wildcard lets any client forge its IP and
# bypass all per-IP rate limiting. Default 127.0.0.1 keeps direct local runs
# (no reverse proxy) unchanged.
FORWARDED_ALLOW_IPS=127.0.0.1

# Account login lockout (08-15-runtime-guardrails).
# After AUTH_LOGIN_MAX_FAILURES consecutive failed logins the username is
# locked for AUTH_LOCKOUT_MINUTES. Redis failure is fail-open (login proceeds).
# Locked accounts return the same 401 as a wrong password (not enumerable).
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOCKOUT_MINUTES=15
