# ============================================================================
# Production environment for the showcase demo deployment.
#
# Copy to .env.prod and fill in real values:
#   cp .env.prod.example .env.prod
#   # edit .env.prod, then:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# SECURITY: This file contains NO real secrets. Every value below is either
# a placeholder, a safe default, or a generation command. NEVER commit a
# filled-in .env.prod to the repository. AUTH_SECRET_KEY, MODEL_API_KEY,
# AUTH_INVITE_CODE, and CONTENT_ENCRYPTION_KEY must never enter the repo or
# the frontend build artifacts.
# ============================================================================

# ----------------------------------------------------------------------------
# PostgreSQL — use strong random passwords, not the dev defaults.
# Generate: openssl rand -hex 24
# ----------------------------------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24
POSTGRES_DB=job_search_agent

# Database URL (matches the postgres credentials above).
DATABASE_URL=postgresql+psycopg://app:CHANGE_ME_openssl_rand_hex_24@postgres:5432/job_search_agent

# Redis (internal only, no port published to host).
REDIS_URL=redis://redis:6379/0

# ----------------------------------------------------------------------------
# Authentication — AUTH_SECRET_KEY signs all access tokens. MUST be set in prod.
# Generate: openssl rand -hex 32
# ----------------------------------------------------------------------------
AUTH_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
AUTH_TOKEN_TTL_MINUTES=720

# Invite code gating registration. Set to a memorable string you share with
# interviewers so they can register independent accounts. Empty disables the
# gate (NOT recommended in prod). Generate: openssl rand -hex 8
AUTH_INVITE_CODE=CHANGE_ME_openssl_rand_hex_8

# Account login lockout (08-15-runtime-guardrails).
# After this many consecutive failures the username is locked for the given
# minutes. Redis failure is fail-open (login proceeds).
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOCKOUT_MINUTES=15

# ----------------------------------------------------------------------------
# Content-at-rest encryption (08-15-content-key-decouple).
# Dedicated Fernet key for encrypting user-supplied long text (e.g. jd_raw).
# MUST be a valid Fernet key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: losing this key makes all enc2$ content unrecoverable. Back it up.
# ----------------------------------------------------------------------------
CONTENT_ENCRYPTION_KEY=CHANGE_ME_fernet_generate_key

# ----------------------------------------------------------------------------
# Reverse-proxy real-IP trust chain (08-15-proxy-real-ip-trust-chain).
# MUST be the frontend container's fixed IP (172.28.0.10).
# NEVER use "*": a wildcard lets any client forge X-Forwarded-For and bypass
# all per-IP rate limiting.
# ----------------------------------------------------------------------------
FORWARDED_ALLOW_IPS=172.28.0.10

# ----------------------------------------------------------------------------
# Rate limiting (per-IP fixed-window counters, Redis-backed, fail-open).
# Model bucket lowered from 30 to 10/min for the demo scenario.
# ----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_MODEL_PER_MINUTE=10
RATE_LIMIT_AUTH_PER_MINUTE=10

# ----------------------------------------------------------------------------
# Model gateway — MODEL_API_KEY is the real provider key. MUST be set in prod.
# When empty the app falls back to the fake provider (no real LLM calls).
# ----------------------------------------------------------------------------
MODEL_PROVIDER=auto
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=CHANGE_ME_real_provider_api_key
MODEL_DEFAULT_MODEL=deepseek-chat

# Daily model call budget (08-15-model-gateway-budget-circuit).
# Every real LLM call (chat + structured) increments a Redis daily counter.
# When the limit is exceeded the call is rejected with 429 and
# /api/v1/health reports model_budget_tripped=true until UTC midnight.
# Set MODEL_DAILY_BUDGET_ENABLED=false to disable (NOT recommended in prod).
# On Redis outage, MODEL_BUDGET_FAIL_OPEN=true lets calls through (the
# provider-side API key quota is the mandatory second line of defense).
MODEL_DAILY_CALL_LIMIT=500
MODEL_DAILY_BUDGET_ENABLED=true
MODEL_BUDGET_FAIL_OPEN=true

# ----------------------------------------------------------------------------
# Queue (arq worker). Namespace prefixes arq queue keys so environments can
# share one Redis instance. Keep the production default.
# ----------------------------------------------------------------------------
QUEUE_NAMESPACE=job-search-agent
QUEUE_JOB_TIMEOUT=300
QUEUE_MAX_RETRIES=2

# Resume upload directory (docker named volume mount).
RESUME_UPLOAD_DIR=/data/resumes

# ----------------------------------------------------------------------------
# BOSS platform adapter — ALL disabled in the showcase deployment.
# The fake adapter is used for the demo approval-boundary flow. The real
# Playwright/CDP/userscript bridge is local-dev only and never runs in prod.
# ----------------------------------------------------------------------------
BOSS_USERSCRIPT_BRIDGE_ENABLED=0
BOSS_ADAPTER_ENABLED=false

# ----------------------------------------------------------------------------
# Frontend build-time demo credential.
# This is a DELIBERATELY PUBLIC demo password (see design.md §2). It is baked
# into the static frontend bundle so the "one-click demo login" button works.
# It is NOT a secret — the demo account's data is resettable and shared.
# Set it to whatever you configured in seed_demo.py (default: demo12345).
# ----------------------------------------------------------------------------
VITE_DEMO_PASSWORD=demo12345
