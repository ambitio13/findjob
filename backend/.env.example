# Backend environment (no secrets committed). Copy to .env and adjust.
APP_ENV=local
API_V1_PREFIX=/api/v1

# PostgreSQL
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/job_search_agent
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# Queue (arq worker runtime). Reuses REDIS_URL as transport.
QUEUE_NAMESPACE=job-search-agent
QUEUE_JOB_TIMEOUT=300
QUEUE_MAX_RETRIES=2

# Model gateway. Leave MODEL_API_KEY empty to use the fake provider locally.
MODEL_PROVIDER=auto
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=
MODEL_DEFAULT_MODEL=deepseek-chat
